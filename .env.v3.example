# v3 (web input). Copy to .env in ~/apps/case-v3 and chmod 600.
V3_PORT=3011
BASE_URL=https://case-v3.baanpin.com
DATABASE_URL=postgres://case_app:<CASE_APP_PASSWORD>@127.0.0.1:5433/case_tracker
SESSION_SECRET=<openssl rand -hex 32>
BOOTSTRAP_ADMIN_EMAIL=chaiwati@sinostech.co.th
# SSO (from .env.sso)
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SECRET_EXPIRES=
# Graph / mail / Telegram: copy from v2 .env
# Jobs: keep OFF while v2 still sends alerts (parallel run)
V3_ALERTS=0
V3_TELEGRAM=0
V3_REPORTS=0
DRY_RUN_EMAIL=0
