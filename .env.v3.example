# v3 (web input). Copy to .env in ~/apps/case-v3 and chmod 600.
V3_PORT=3011
BASE_URL=https://case.sinostech.co.th:9443
# Direct HTTPS (firewall forwards public :9443 to this server). Certificate from acme.sh, reloaded automatically.
HTTPS_PORT=9443
TLS_CERT_FILE=/home/chaiwat/apps/case-v3/tls/fullchain.pem
TLS_KEY_FILE=/home/chaiwat/apps/case-v3/tls/key.pem
# Redirect old host names (case.baanpin.com, case-v3.baanpin.com) to BASE_URL
CANONICAL_REDIRECT=1
DATABASE_URL=postgres://case_app:<CASE_APP_PASSWORD>@127.0.0.1:5433/case_tracker
SESSION_SECRET=<openssl rand -hex 32>
BOOTSTRAP_ADMIN_EMAIL=chaiwati@sinostech.co.th
# SSO (from .env.sso)
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SECRET_EXPIRES=
# Graph / mail / Telegram: copy from v2 .env
# Jobs: keep OFF while v2 still sends alerts (parallel run)
V3_ALERTS=0
V3_TELEGRAM=0
V3_REPORTS=0
DRY_RUN_EMAIL=0

# Customer intake (LINE OA / one-time links): reminders, chatbot webhook, cleanup. On by default.
V3_INTAKE=1
# Where customer attachments are stored (default ./data/intake-files)
# INTAKE_FILE_DIR=/home/chaiwat/apps/case-v3/data/intake-files

# Company identity on the login page and the customer form (helps browsers and customers trust the pages)
# COMPANY_NAME=Sinostech
# COMPANY_LEGAL_NAME=SINO S-Tech Co., Ltd.
# COMPANY_URL=https://www.sinostech.co.th
# SUPPORT_PHONE=02-xxx-xxxx
# SUPPORT_EMAIL=support@sinostech.co.th
# SECURITY_CONTACT=it@sinostech.co.th
# Daily check whether Chrome flags the site as "Dangerous" (Google Cloud API key: Web Risk API, or Safe Browsing API)
# WEB_RISK_API_KEY=
# SAFE_BROWSING_API_KEY=

# Phone / browser notifications (installed app). Generate once on the server:
#   node -e 'const k=require("web-push").generateVAPIDKeys();console.log("VAPID_PUBLIC_KEY="+k.publicKey+"\nVAPID_PRIVATE_KEY="+k.privateKey)' >> .env
# Without these two keys notifications stay off. Never share VAPID_PRIVATE_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@sinostech.co.th
